{
    "name": "secord-desktop",
    "version": "0.3.0-beta.4",
    "private": true,
    "description": "SeCord (SoulEater), a separate Discord desktop app with a custom client",
    "keywords": [],
    "homepage": "https://github.com/nociferico/SeCord-Desktop",
    "license": "GPL-3.0-or-later",
    "author": "Vendicated <vendicated@riseup.net>",
    "main": "dist/js/main.js",
    "scripts": {
        "build": "node scripts/build/copyNociCord.mjs && tsx scripts/build/build.mts",
        "build:nocicord": "pnpm -C ../NociCord build:nocicord && pnpm build",
        "package:nocicord": "pnpm build:nocicord && electron-builder --win nsis --x64 --config.directories.output=release",
        "build:dev": "pnpm build --dev",
        "buildLibVesktop": "pnpm -C packages/libvesktop install && pnpm -C packages/libvesktop run build",
        "package": "pnpm build && electron-builder",
        "package:dir": "pnpm build && electron-builder --dir",
        "lint": "oxlint src scripts packages/discord-rpc",
        "lint:fix": "pnpm lint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "start": "pnpm build && electron --enable-source-maps .",
        "start:dev": "pnpm build:dev && electron --enable-source-maps .",
        "start:watch": "pnpm build:dev && tsx scripts/startWatch.mts",
        "test": "pnpm lint && pnpm fmt:check && pnpm testTypes",
        "testTypes": "tsc --noEmit",
        "watch": "pnpm build --watch",
        "generateMeta": "tsx scripts/utils/generateMeta.mts"
    },
    "dependencies": {
        "electron-updater": "6.6.2"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^7.2.5"
    },
    "devDependencies": {
        "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
        "@types/node": "^26.6.5",
        "@types/react": "19.2.9",
        "@vencord/types": "^1.15.14",
        "discord-rpc": "workspace:*",
        "electron": "45.1.0",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.28.2",
        "eslint-plugin-simple-header": "^1.2.2",
        "libvesktop": "link:packages/libvesktop",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "source-map-support": "^0.5.21",
        "tsx": "^4.23.15",
        "type-fest": "^5.10.0",
        "typescript": "^6.0.3",
        "xml-formatter": "^3.6.7"
    },
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=22",
        "pnpm": ">=11"
    },
    "build": {
        "appId": "app.secord.desktop",
        "productName": "SeCord",
        "executableName": "SeCord",
        "files": [
            "!*",
            "!node_modules",
            "dist/js",
            "static",
            "package.json",
            "LICENSE"
        ],
        "beforePack": "scripts/build/beforePack.mjs",
        "afterPack": "scripts/build/afterPack.mjs",
        "toolsets": {
            "appimage": "1.0.3"
        },
        "linux": {
            "icon": "build/icon.svg",
            "category": "Network",
            "maintainer": "vendicated+vesktop@riseup.net",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "desktop": {
                "entry": {
                    "Name": "SeCord",
                    "GenericName": "Internet Messenger",
                    "Type": "Application",
                    "Categories": "Network;InstantMessaging;Chat;",
                    "Keywords": "discord;nocicord;electron;chat;",
                    "StartupWMClass": "secord"
                }
            }
        },
        "mac": {
            "target": [
                {
                    "target": "default",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "category": "public.app-category.social-networking",
            "darkModeSupport": true,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "This app needs access to the microphone",
                "NSCameraUsageDescription": "This app needs access to the camera",
                "com.apple.security.device.audio-input": true,
                "com.apple.security.device.camera": true,
                "CFBundleIconName": "Icon"
            },
            "requirements": "build/signing-requirements.txt",
            "notarize": true
        },
        "dmg": {
            "background": "build/background.tiff",
            "icon": "build/icon.icns",
            "iconSize": 105,
            "window": {
                "width": 512,
                "height": 340
            },
            "contents": [
                {
                    "x": 140,
                    "y": 160
                },
                {
                    "x": 372,
                    "y": 160,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "nsis": {
            "oneClick": false
        },
        "win": {
            "icon": "build/secord.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "rpm": {
            "fpm": [
                "--rpm-rpmbuild-define=_build_id_links none"
            ]
        },
        "electronFuses": {
            "runAsNode": false,
            "enableCookieEncryption": false,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": false,
            "onlyLoadAppFromAsar": true,
            "loadBrowserProcessSpecificV8Snapshot": false,
            "grantFileProtocolExtraPrivileges": false
        }
    }
}
